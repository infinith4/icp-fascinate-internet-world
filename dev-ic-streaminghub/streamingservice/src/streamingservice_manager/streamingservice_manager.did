type CanisterStatusResult = record {
    controllers: vec principal;
};

service : {
    "create_and_install_canister": () -> (variant { Ok: text; Err: text });
    "deposit": (text) -> (variant { Ok; Err: text });
    "begin_canister": (text) -> (variant { Ok; Err: text });
    "end_canister": (text) -> (variant { Ok; Err: text });
    "remove_canister": (text) -> (variant { Ok; Err: text });
    "canister_condition": (text) -> (variant { Ok: CanisterStatusResult; Err: text });
    "call_canister_method": (text, text, text) -> (variant { Ok: text; Err: text });
    "get_canister_id_list": () -> (vec record { text; text; }) query;
}